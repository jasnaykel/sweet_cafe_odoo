# ============================================================
# Sweet Café QA Agent — Variables de Entorno
# Copia este archivo como .env y ajusta los valores
# ============================================================

# ─── Odoo 19 ────────────────────────────────────────────────
ODOO_URL=http://localhost:8069

# Base de datos Odoo (nombre de la db en la instancia)
ODOO_DB=sweet_cafe

# Credenciales de administrador Odoo
ODOO_ADMIN_EMAIL=admin
ODOO_ADMIN_PASSWORD=admin

# Credencial de usuario de prueba (sin permisos de admin)
ODOO_USER_EMAIL=usuario@sweetcafe.cu
ODOO_USER_PASSWORD=test1234

# ─── Configuración de tests ──────────────────────────────────
# Poner HEADLESS=false para ver el navegador durante los tests
HEADLESS=true

# Retardo entre acciones en ms (útil para depurar, 0 en CI)
SLOW_MO=0

# Timeout global de cada test en ms
TIMEOUT=120000

# ─── Reportes ────────────────────────────────────────────────
REPORT_OUTPUT_DIR=./reports
SCREENSHOT_ON_FAILURE=true

# ─── IA (opcional) ───────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_key_here
