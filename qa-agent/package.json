{
  "name": "sweet-cafe-qa-agent",
  "version": "2.0.0",
  "description": "QA Tests visuales para Sweet Café — Sistema Odoo 19",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:auth": "playwright test tests/auth/",
    "test:branches": "playwright test tests/sweet_cafe/branches.spec.ts",
    "test:products": "playwright test tests/sweet_cafe/products.spec.ts",
    "test:reservations": "playwright test tests/sweet_cafe/reservations.spec.ts",
    "test:inventory": "playwright test tests/sweet_cafe/inventory.spec.ts",
    "test:pos": "playwright test tests/sweet_cafe/pos.spec.ts",
    "test:hr": "playwright test tests/sweet_cafe/hr.spec.ts",
    "test:payroll": "playwright test tests/sweet_cafe/payroll.spec.ts",
    "test:ecommerce": "playwright test tests/sweet_cafe/ecommerce.spec.ts",
    "test:ecommerce-reservation": "playwright test tests/sweet_cafe/ecommerce-reservation.spec.ts",
    "test:sweet-cafe": "playwright test tests/sweet_cafe/",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:mobile": "playwright test --project=mobile-chrome",
    "report": "playwright show-report reports/playwright-report",
    "discover": "tsx src/index.ts discover",
    "generate": "tsx src/index.ts generate",
    "execute": "tsx src/index.ts execute",
    "analyze": "tsx src/index.ts analyze",
    "full-qa": "tsx src/index.ts full",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.58.2",
    "axios": "^1.6.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.6.1",
    "glob": "^10.3.10",
    "handlebars": "^4.7.8",
    "inquirer": "^9.2.12",
    "openai": "^4.20.0",
    "ora": "^7.0.1",
    "typescript": "^5.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "tsx": "^4.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
