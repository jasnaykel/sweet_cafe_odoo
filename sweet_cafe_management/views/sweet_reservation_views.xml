<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════════════════════════════════════
         sweet.reservation — Form View
    ════════════════════════════════════════ -->
    <record id="sweet_reservation_form" model="ir.ui.view">
        <field name="name">sweet.reservation.form</field>
        <field name="model">sweet.reservation</field>
        <field name="arch" type="xml">
            <form string="Reserva de Pedido">
                <header>
                    <button name="action_confirm" string="Confirmar" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_ready" string="Marcar como Lista" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_done" string="Entregada" type="object"
                            class="btn-success" invisible="state != 'ready'"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_draft" string="Reabrir" type="object"
                            invisible="state != 'cancelled'"/>
                    <button name="action_create_sale_order" string="Crear Orden de Venta"
                            type="object" class="btn-secondary"
                            invisible="state not in ('confirmed', 'ready') or sale_order_id != False"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,ready,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_sale_order" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="sale_order_id == False">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Orden de Venta</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Cliente">
                            <field name="partner_id" options="{'no_create_edit': True}"/>
                            <field name="partner_phone"/>
                            <field name="partner_email"/>
                            <field name="origin"/>
                        </group>
                        <group string="Entrega">
                            <field name="branch_id"/>
                            <field name="delivery_date"/>
                            <field name="delivery_time"/>
                            <field name="deposit_amount"/>
                            <field name="deposit_paid"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="flavor"/>
                                    <field name="qty"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" readonly="1"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total" class="oe_subtotal_footer_separator"
                                       widget="monetary"/>
                            </group>
                        </page>
                        <page string="Notas" name="notes">
                            <group>
                                <field name="customer_notes" colspan="2" nolabel="1"
                                       placeholder="Indicaciones del cliente: decoración, mensaje, alergias..."/>
                            </group>
                            <group>
                                <field name="internal_notes" colspan="2" nolabel="1"
                                       placeholder="Notas internas del equipo..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="sweet_reservation_list" model="ir.ui.view">
        <field name="name">sweet.reservation.list</field>
        <field name="model">sweet.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservas" decoration-success="state == 'done'"
                  decoration-warning="state == 'ready'"
                  decoration-info="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="branch_id"/>
                <field name="delivery_date"/>
                <field name="delivery_time"/>
                <field name="amount_total" widget="monetary"/>
                <field name="deposit_paid" widget="boolean_toggle"/>
                <field name="origin" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'ready'"
                       decoration-info="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="sweet_reservation_search" model="ir.ui.view">
        <field name="name">sweet.reservation.search</field>
        <field name="model">sweet.reservation</field>
        <field name="arch" type="xml">
            <search string="Reservas">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="branch_id"/>
                <filter name="today" string="Entrega Hoy"
                        domain="[('delivery_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="week" string="Esta Semana"
                        domain="[('delivery_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="draft" string="Borradores" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmadas" domain="[('state','=','confirmed')]"/>
                <filter name="ready" string="Listas" domain="[('state','=','ready')]"/>
                <filter name="done" string="Entregadas" domain="[('state','=','done')]"/>
                <filter name="cancelled" string="Canceladas" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="website" string="Desde Web" domain="[('origin','=','website')]"/>
                <filter name="no_deposit" string="Sin Seña" domain="[('deposit_paid','=',False),('state','!=','done')]"/>
                <group>
                    <filter name="group_branch" string="Sucursal" domain="[]" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_state" string="Estado" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Fecha Entrega" domain="[]" context="{'group_by': 'delivery_date'}"/>
                    <filter name="group_origin" string="Origen" domain="[]" context="{'group_by': 'origin'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="sweet_reservation_kanban" model="ir.ui.view">
        <field name="name">sweet.reservation.kanban</field>
        <field name="model">sweet.reservation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="delivery_date"/>
                <field name="amount_total"/>
                <field name="state"/>
                <field name="deposit_paid"/>
                <field name="branch_id"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <strong><field name="name"/></strong>
                        </div>
                        <div>
                            <i class="fa fa-user me-1" title="Cliente"/><field name="partner_id"/>
                        </div>
                        <div>
                            <i class="fa fa-calendar me-1" title="Fecha de entrega"/><field name="delivery_date"/>
                            <span t-if="record.delivery_time.raw_value" class="ms-2 text-muted">
                                <field name="delivery_time"/>
                            </span>
                        </div>
                        <div>
                            <i class="fa fa-map-marker me-1" title="Sucursal"/><field name="branch_id"/>
                        </div>
                        <div class="mt-1">
                            <strong><field name="amount_total" widget="monetary"/></strong>
                            <span t-if="record.deposit_paid.raw_value" class="badge text-bg-success ms-2">Seña ✓</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sweet_reservations" model="ir.actions.act_window">
        <field name="name">Reservas</field>
        <field name="res_model">sweet.reservation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Aún no hay reservas! Los pedidos online y telefónicos aparecerán aquí.
            </p>
        </field>
    </record>

    <!-- Calendar Action (for planning) -->
    <record id="action_sweet_reservations_calendar" model="ir.actions.act_window">
        <field name="name">Calendario de Reservas</field>
        <field name="res_model">sweet.reservation</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

    <!-- Calendar View -->
    <record id="sweet_reservation_calendar" model="ir.ui.view">
        <field name="name">sweet.reservation.calendar</field>
        <field name="model">sweet.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Reservas" date_start="delivery_date"
                      color="branch_id" mode="month" quick_create="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="amount_total"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

</odoo>
