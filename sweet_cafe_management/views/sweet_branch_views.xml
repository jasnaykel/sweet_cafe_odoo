<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════
         sweet.branch — Sucursal Views
    ═══════════════════════════════════════════════ -->

    <!-- List view -->
    <record id="view_sweet_branch_list" model="ir.ui.view">
        <field name="name">sweet.branch.list</field>
        <field name="model">sweet.branch</field>
        <field name="arch" type="xml">
            <list string="Sucursales">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="branch_type"/>
                <field name="warehouse_id"/>
                <field name="manager_id"/>
                <field name="company_id" column_invisible="True"/>
                <field name="pos_config_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_sweet_branch_form" model="ir.ui.view">
        <field name="name">sweet.branch.form</field>
        <field name="model">sweet.branch</field>
        <field name="arch" type="xml">
            <form string="Sucursal">
                <header/>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_pos_configs"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cash-register"
                                invisible="pos_config_count == 0">
                            <field name="pos_config_count" widget="statinfo" string="POS"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre de la Sucursal"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Información General">
                            <field name="code"/>
                            <field name="branch_type"/>
                            <field name="active"/>
                            <field name="address"/>
                            <field name="phone"/>
                        </group>
                        <group string="Operaciones">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="warehouse_id"/>
                            <field name="manager_id"/>
                            <field name="invoice_series"/>
                            <field name="pos_series"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_sweet_branch_search" model="ir.ui.view">
        <field name="name">sweet.branch.search</field>
        <field name="model">sweet.branch</field>
        <field name="arch" type="xml">
            <search string="Sucursales">
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_sweet_branch" model="ir.actions.act_window">
        <field name="name">Sucursales</field>
        <field name="res_model">sweet.branch</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sweet_branch_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree su primera sucursal
            </p>
            <p>Las sucursales representan las tiendas físicas o puntos de venta de Sweet Café.</p>
        </field>
    </record>
</odoo>
