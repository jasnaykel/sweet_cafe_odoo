<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════
         DEMO DATA — Sweet Café Employees (RRHH Cuba)
         Only loaded in demo/testing environments.
         Uses field names from l10n_cu_hr (identification_id,
         schooling_level_id, occupational_category_id) and
         standard Odoo hr.employee (marital).
    ═══════════════════════════════════════════════ -->

    <!-- Gerente / Administrador -->
    <record id="employee_gerente" model="hr.employee">
        <field name="name">Ana García Martínez</field>
        <field name="job_title">Gerente General</field>
        <field name="gender">female</field>
        <field name="identification_id">85122345678</field>
        <field name="schooling_level_id" ref="l10n_cu_hr.schooling_level_uni"/>
        <field name="marital">married</field>
        <field name="num_hijos">2</field>
        <field name="occupational_category_id" ref="l10n_cu_hr.schooling_level_c"/>
        <field name="salary_scale_id" ref="salary_scale_14"/>
        <field name="forma_pago">escala</field>
        <field name="horario_trabajo">continuo</field>
        <field name="branch_id" ref="branch_matriz"/>
    </record>

