    <!-- Cake Antillano de Chocolate -->
    <record id="product_cake_chocolate" model="product.template">
        <field name="name">Cake Antillano de Chocolate</field>
        <field name="type">consu</field>
        <field name="categ_id" ref="product_category_cakes"/>
        <field name="is_pastry" eval="True"/>
        <field name="sweet_product_type">cake</field>
        <field name="list_price">12.50</field>
        <field name="baking_time">1.5</field>
        <field name="baking_temp">180</field>
        <field name="requires_refrigeration" eval="True"/>
        <field name="shelf_life_days">3</field>
        <field name="custom_order" eval="True"/>
        <field name="min_advance_days">2</field>
        <field name="sale_ok" eval="True"/>
        <field name="purchase_ok" eval="False"/>
        <field name="tracking">lot</field>
        <field name="description_sale">Exquisito cake de chocolate con relleno de crema antillana. Elaborado artesanalmente.</field>
    </record>

