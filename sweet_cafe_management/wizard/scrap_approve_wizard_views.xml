<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════
         Scrap Approve Wizard — Views
    ═══════════════════════════════════════════════ -->

    <record id="view_sweet_scrap_approve_wizard_form" model="ir.ui.view">
        <field name="name">sweet.scrap.approve.wizard.form</field>
        <field name="model">sweet.scrap.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Aprobar / Rechazar Merma">
                <group>
                    <field name="scrap_id" readonly="1"/>
                    <field name="action" widget="radio"/>
                    <field name="supervisor_id"/>
                    <field name="rejection_reason"
                           invisible="action != 'reject'"
                           required="action == 'reject'"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Confirmar"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
