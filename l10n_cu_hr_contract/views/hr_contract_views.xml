<odoo>
    <!--
        Base form view for hr.version (contract records) in Odoo 19.
        Standard Odoo 19 does not ship a standalone form for hr.version;
        contracts are opened via action_open_version from the list.
        We define the base form here so that l10n_cu_hr_employee_contract
        and sweet_cafe_management can inherit additional fields.
    -->
    <record id="hr_version_form_view" model="ir.ui.view">
        <field name="name">hr.version.form</field>
        <field name="model">hr.version</field>
        <field name="arch" type="xml">
            <form string="Contrato de Trabajo">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group name="top_info_left">
                            <field name="employee_id"/>
                            <field name="contract_date_start" required="1"/>
                            <field name="contract_date_end"/>
                            <field name="resource_calendar_id"/>
                        </group>
                        <group name="top_info_right">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="contract_type_id"/>
                            <field name="wage" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Régimen de Contribución" name="contribution">
                            <group>
                                <field name="multi_job"/>
                                <field name="regimen_contribution" invisible="multi_job"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Override action_open_version to use our form -->
    <record id="hr_version_action_form_override" model="ir.actions.act_window">
        <field name="name">Contratos</field>
        <field name="res_model">hr.version</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('hr.hr_version_list_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('l10n_cu_hr_contract.hr_version_form_view')})
        ]"/>
        <field name="domain">[('employee_id', '!=', False)]</field>
    </record>
</odoo>
