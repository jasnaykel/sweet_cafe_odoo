<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════
         eCommerce Public Categories — Sweet Café
         model: product.public.category  (sidebar de la tienda)
         DIFERENTE de product.category (categorías internas)
    ═══════════════════════════════════════════════════════ -->

    <record id="public_category_cakes" model="product.public.category">
        <field name="name">Cakes Antillanos</field>
        <field name="sequence">1</field>
    </record>

    <record id="public_category_tartaletas" model="product.public.category">
        <field name="name">Tartaletas</field>
        <field name="sequence">2</field>
    </record>

    <record id="public_category_dulces" model="product.public.category">
        <field name="name">Dulces Tradicionales</field>
        <field name="sequence">3</field>
    </record>

    <record id="public_category_galletas" model="product.public.category">
        <field name="name">Galletas y Macarons</field>
        <field name="sequence">4</field>
    </record>

    <record id="public_category_bebidas" model="product.public.category">
        <field name="name">Bebidas</field>
        <field name="sequence">5</field>
    </record>

    <record id="public_category_chocolates" model="product.public.category">
        <field name="name">Chocolates</field>
        <field name="sequence">6</field>
    </record>

    <record id="public_category_regalos" model="product.public.category">
        <field name="name">Cestas y Regalos</field>
        <field name="sequence">7</field>
    </record>
</odoo>
