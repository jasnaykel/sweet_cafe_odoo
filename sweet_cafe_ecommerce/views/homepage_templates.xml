<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Google Fonts — loaded once in <head> for all pages -->
    <template id="sweet_google_fonts" inherit_id="website.layout" priority="5"
              name="Sweet Café Google Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&amp;family=Inter:wght@300;400;500;600&amp;display=swap"
                  rel="stylesheet"/>
        </xpath>
    </template>

    <!-- Custom Logo override -->
    <template id="sweet_logo_override" inherit_id="website.option_header_brand_logo" priority="20"
              name="Sweet Caf&#233; Logo">
        <xpath expr="//span[@t-field='website.logo']" position="replace">
            <img src="/sweet_cafe_ecommerce/static/src/img/sweet_logo.svg"
                 alt="Sweet Caf&#233;"
                 role="img"
                 style="height: 46px; width: auto;"/>
        </xpath>
    </template>

    <!-- Dark mode toggle — rendered server-side inside user_dropdown -->
    <template id="sweet_dark_toggle" inherit_id="portal.user_dropdown" priority="5"
              name="Sweet Caf&#233; Dark Mode Toggle">
        <xpath expr="//t[@t-set='is_connected']" position="after">
            <li class="nav-item d-flex align-items-center">
                <button id="sw-theme-toggle" type="button" class="sw-theme-nav-btn"
                        aria-label="Cambiar tema claro / oscuro"
                        title="Claro / Oscuro"
                        onclick="(function(btn){
                            var h=document.documentElement;
                            var dark=h.getAttribute('data-bs-theme')==='dark';
                            var next=dark?'light':'dark';
                            h.setAttribute('data-bs-theme',next);
                            try{localStorage.setItem('sw-theme',next);}catch(e){}
                            btn.querySelector('.sw-theme-icon').textContent=next==='dark'?'\uD83C\uDF19':'\u2600\uFE0F';
                        })(this)">
                    <span class="sw-theme-icon">&#9728;&#xFE0F;</span>
                </button>
            </li>
        </xpath>
    </template>

    <!-- Restore saved theme preference on page load -->
    <template id="sweet_theme_restore" inherit_id="website.layout" priority="3"
              name="Sweet Caf&#233; Theme Restore">
        <xpath expr="//head" position="inside">
            <script>
            //<![CDATA[
            (function(){
                try {
                    var t = localStorage.getItem('sw-theme');
                    if (t) {
                        document.documentElement.setAttribute('data-bs-theme', t);
                    }
                } catch(e) {}
            })();
            //]]>
            </script>
        </xpath>
    </template>

    <!-- Homepage Custom Templates -->
    <!--
        sc-top-bar: barra de contacto que aparece en TODAS las páginas del sitio web.
        Hereda website.layout (plantilla base global de Odoo web) → es el comportamiento correcto.
        Para ocultarla: Sitio web → Editor → desactivar "Barra de contacto Sweet Café".
        Para eliminarla permanentemente: borrar este template.
    -->
    <template id="header_sc_contact" inherit_id="website.layout" priority="10"
              customize_show="True" name="Barra de contacto Sweet Café">
        <xpath expr="//header" position="before">
            <div class="sc-top-bar py-1 d-none d-lg-block text-white">
                <div class="container d-flex justify-content-between small">
                    <span>
                        <i class="fa fa-phone me-1" title="Teléfono"/>
                        +(53) 7 830-XXXX
                    </span>
                    <span>
                        <i class="fa fa-map-marker me-1" title="Ubicación"/>
                        Encuentra tu sucursal más cercana — <strong>Sweet Café Cuba</strong>
                    </span>
                </div>
            </div>
        </xpath>
    </template>
    
    <template id="homepage" inherit_id="website.homepage" name="Sweet Café Homepage">
        <xpath expr="//div[@id='wrap']" position="inside">
            <div class="oe_structure">
                <!-- Pre-populated snippets for a ready-to-use look -->
                <t t-call="sweet_cafe_ecommerce.s_sweet_hero"/>
                <t t-call="sweet_cafe_ecommerce.s_sweet_flavors"/>
                <t t-call="sweet_cafe_ecommerce.s_sweet_product_carousel"/>
                <!-- Best Sellers & Available Products -->
                <t t-call="sweet_cafe_ecommerce.s_sweet_best_sellers"/>
                <t t-call="sweet_cafe_ecommerce.s_sweet_about_us"/>
                <t t-call="sweet_cafe_ecommerce.s_sweet_branches"/>
                <t t-call="sweet_cafe_ecommerce.s_sweet_custom_order"/>
                <!-- Reserve CTA -->
                <t t-call="sweet_cafe_ecommerce.s_sweet_reservation_cta"/>
            </div>
            <div class="oe_structure"/>
        </xpath>
    </template>

    <!-- ══════════════════════════════════════════════
         Best Sellers Section (dynamic, from sale data)
    ══════════════════════════════════════════════ -->
    <template id="s_sweet_best_sellers" name="Sweet Café — Más Vendidos">
        <section class="sc-best-sellers py-5" style="background: linear-gradient(160deg, #2C1501 0%, #5C3D2E 100%); position: relative; overflow: hidden;">
            <div class="container position-relative" style="z-index: 1;">

                <div class="sw-section-header text-center mb-5">
                    <h2 style="color: #F5E6D3 !important;">⭐ Los Más Vendidos</h2>
                    <p style="color: #E8C9A0;">Los favoritos de nuestros clientes, siempre disponibles.</p>
                </div>

                <!-- Server-side best-sellers carousel -->
                <t t-set="bs_groups" t-value="request.env['sale.report'].sudo().read_group([('state','in',('sale','done'))], ['product_tmpl_id','product_uom_qty:sum'], ['product_tmpl_id'], orderby='product_uom_qty desc', limit=12)"/>
                <t t-set="bs_tmpl_ids" t-value="[g['product_tmpl_id'][0] for g in bs_groups if g.get('product_tmpl_id')]"/>
                <t t-set="best_products" t-value="request.env['product.template'].sudo().browse(bs_tmpl_ids).filtered(lambda p: p.active and p.sale_ok) if bs_tmpl_ids else request.env['product.template'].sudo().search([('sale_ok','=',True),('active','=',True)], limit=12)"/>
                <t t-set="best_chunks" t-value="[best_products[i:i+4] for i in range(0, len(best_products), 4)]"/>

                <div id="sweetBestSellersCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="7000">
                    <div class="carousel-inner">
                        <t t-foreach="best_chunks" t-as="chunk">
                            <div t-attf-class="carousel-item #{'active' if chunk_index == 0 else ''}">
                                <div class="row g-4 px-2">
                                    <t t-foreach="chunk" t-as="product">
                                        <div class="col-md-3 col-sm-6">
                                            <div class="sw-product-card card h-100">
                                                <div class="sw-card-img-wrap">
                                                    <a t-attf-href="/shop/product/#{product.id}">
                                                        <img t-attf-src="/web/image/product.template/#{product.id}/image_512"
                                                             loading="lazy"
                                                             t-att-alt="product.name"/>
                                                    </a>
                                                    <span class="sw-product-badge">⭐ Top Ventas</span>
                                                </div>
                                                <div class="card-body d-flex flex-column">
                                                    <h5 class="card-title text-truncate">
                                                        <a t-attf-href="/shop/product/#{product.id}"
                                                           class="text-decoration-none text-chocolate"
                                                           t-field="product.name"/>
                                                    </h5>
                                                    <div class="mt-auto">
                                                        <span class="sw-price d-block mb-2"
                                                              t-field="product.list_price"
                                                              t-options="{'widget':'monetary','display_currency':product.currency_id}"/>
                                                        <form action="/sweet/cart/add" method="POST" class="sweet_add_cart_form">
                                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                            <input type="hidden" name="product_id" t-att-value="product.product_variant_id.id"/>
                                                            <div class="sw-qty-group mb-2">
                                                                <button type="button" class="sw-qty-btn"
                                                                        onclick="var i=this.parentNode.querySelector('input[name=add_qty]');i.value=Math.max(1,parseInt(i.value)-1)">−</button>
                                                                <input type="number" name="add_qty" value="1" min="1"
                                                                       class="sw-qty-val form-control border-0 bg-transparent p-0"
                                                                       style="width:36px;text-align:center;font-weight:600;color:#5C3D2E;"/>
                                                                <button type="button" class="sw-qty-btn"
                                                                        onclick="var i=this.parentNode.querySelector('input[name=add_qty]');i.value=parseInt(i.value)+1">+</button>
                                                            </div>
                                                            <button type="submit" class="btn btn-primary btn-sm w-100">
                                                                <i class="fa fa-shopping-cart me-1"/>Añadir
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                        <t t-if="not best_products">
                            <div class="carousel-item active">
                                <div class="text-center py-5">
                                    <p style="color: rgba(245,230,211,0.5);">Aún no hay ventas registradas.</p>
                                </div>
                            </div>
                        </t>
                    </div>

                    <button class="carousel-control-prev" type="button"
                            data-bs-target="#sweetBestSellersCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"/>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button"
                            data-bs-target="#sweetBestSellersCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"/>
                        <span class="visually-hidden">Siguiente</span>
                    </button>
                </div>

                <div class="text-center mt-5">
                    <a href="/shop" class="btn btn-outline-chocolate px-5">
                        Ver todos los productos <i class="fa fa-arrow-right ms-2"/>
                    </a>
                </div>
            </div>
        </section>
    </template>

    <!-- ══════════════════════════════════════════════
         Reserve CTA Banner
    ══════════════════════════════════════════════ -->
    <template id="s_sweet_reservation_cta" name="Sweet Café — CTA Reservar">
        <section class="sc-reservation-cta py-5 text-center">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-7">
                        <h2 class="fw-bold mb-3">🎂 ¿Tienes un pedido especial?</h2>
                        <p class="lead mb-4">Reserva con anticipación y personalizamos tu dulce: decoración, sabor, tamaño y mensaje.</p>
                        <a href="/reservar" class="btn px-5 fw-bold me-3">
                            Reservar ahora
                        </a>
                        <a href="/reservar/estado" class="btn px-4">
                            Ver mi reserva
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
