<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_sweet_product_carousel" name="Sweet Product Carousel">
        <section class="s_sweet_product_carousel py-5" style="background-color: #fff;">
            <div class="container">
                <div class="text-center mb-5">
                    <h2 class="display-5 text-chocolate">Nuestras Especialidades</h2>
                    <p class="text-muted">Directo del horno a tu carrito.</p>
                </div>

                <div id="sweetProductCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="7000">
                    <div class="carousel-inner">
                        <t t-set="products" t-value="request.env['product.template'].sudo().search(
                            [('sale_ok', '=', True), ('active', '=', True)], limit=12)"/>
                        <t t-set="chunks" t-value="[products[i:i + 4] for i in range(0, len(products), 4)]"/>
                        
                        <t t-foreach="chunks" t-as="chunk">
                            <div t-attf-class="carousel-item #{'active' if chunk_index == 0 else ''}">
                                <div class="row">
                                    <t t-foreach="chunk" t-as="product">
                                        <div class="col-md-3 mb-4">
                                            <div class="card h-100 border-0 shadow-sm transition-base hover-elevate">
                                                <div class="position-relative overflow-hidden" style="height: 200px;">
                                                    <img t-attf-src="/web/image/product.template/#{product.id}/image_512" class="card-img-top h-100 w-100 object-fit-cover" t-att-alt="product.name"/>
                                                    <t t-if="product.is_pastry">
                                                        <span class="badge position-absolute top-0 end-0 m-2" style="background-color: #FFB7C5; color: #8B4513;">Pastelería</span>
                                                    </t>
                                                </div>
                                                <div class="card-body d-flex flex-column p-4">
                                                    <h5 class="card-title text-truncate" t-field="product.name"/>
                                                    <div class="mt-auto">
                                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                                            <span class="h5 mb-0 text-chocolate fw-bold" t-field="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                                                        </div>

                                                        <!-- Add to Cart — uses /sweet/cart/add (type=http) because
                                                             /shop/cart/update is type=jsonrpc in Odoo 17+ -->
                                                        <form action="/sweet/cart/add" method="POST" class="sweet_add_cart_form">
                                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                            <input type="hidden" name="product_id" t-att-value="product.product_variant_id.id"/>

                                                            <div class="input-group mb-2">
                                                                <button class="btn btn-outline-secondary btn-sm" type="button"
                                                                        onclick="this.parentNode.querySelector('input[name=add_qty]').stepDown()">-</button>
                                                                <input type="number" class="form-control form-control-sm text-center"
                                                                       name="add_qty" value="1" min="1"/>
                                                                <button class="btn btn-outline-secondary btn-sm" type="button"
                                                                        onclick="this.parentNode.querySelector('input[name=add_qty]').stepUp()">+</button>
                                                            </div>
                                                            <button type="submit" class="btn btn-chocolate btn-sm w-100 rounded-pill">
                                                                <i class="fa fa-shopping-cart me-1"/> A&#241;adir
                                                            </button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </t>
                        <t t-if="not products">
                            <div class="carousel-item active">
                                <div class="text-center py-5">
                                    <p class="text-muted italic">Próximamente más delicias...</p>
                                </div>
                            </div>
                        </t>
                    </div>
                    
                    <button class="carousel-control-prev" type="button" data-bs-target="#sweetProductCarousel" data-bs-slide="prev" style="width: 5%;">
                        <span class="carousel-control-prev-icon bg-chocolate rounded-circle p-3" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#sweetProductCarousel" data-bs-slide="next" style="width: 5%;">
                        <span class="carousel-control-next-icon bg-chocolate rounded-circle p-3" aria-hidden="true"></span>
                        <span class="visually-hidden">Siguiente</span>
                    </button>
                </div>
            </div>
        </section>

        <script type="text/javascript">
        (function () {
            /* Update the Odoo header cart badge without page reload */
            function updateCartBadge(qty) {
                document.querySelectorAll('.o_wsale_my_cart_quantity, .my_cart_quantity').forEach(function (el) {
                    el.textContent = qty;
                    el.style.display = qty > 0 ? '' : 'none';
                });
            }

            document.querySelectorAll('.sweet_add_cart_form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var productId = parseInt(form.querySelector('input[name=product_id]').value);
                    var qty = parseInt(form.querySelector('input[name=add_qty]').value) || 1;
                    var btn = form.querySelector('button[type=submit]');
                    btn.disabled = true;

                    fetch('/sweet/cart/add', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({jsonrpc:'2.0', method:'call', params:{product_id: productId, add_qty: qty}}),
                        credentials: 'same-origin',
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        var result = data.result || {};
                        if (result.cart_quantity !== undefined) {
                            updateCartBadge(result.cart_quantity);
                            btn.innerHTML = '<i class="fa fa-check me-1"></i> A&#241;adido';
                            btn.classList.replace('btn-chocolate', 'btn-success');
                            setTimeout(function () {
                                btn.innerHTML = '<i class="fa fa-shopping-cart me-1"></i> A&#241;adir';
                                btn.classList.replace('btn-success', 'btn-chocolate');
                                btn.disabled = false;
                            }, 1800);
                        } else {
                            btn.disabled = false;
                        }
                    })
                    .catch(function () { btn.disabled = false; });
                });
            });
        })();
        </script>
    </template>
</odoo>
