<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_sweet_flavors" name="Sweet Flavors Grid">
        <section class="s_sweet_flavors py-5"
                 style="background: linear-gradient(135deg, #FDF6EC 0%, #F5E6D3 100%);">
            <div class="container">
                <div class="sw-section-header text-center mb-5 sw-reveal">
                    <h2>Nuestros Sabores Estrella</h2>
                    <p class="mt-2">Ingredientes de primera calidad en cada elaboración artesanal.</p>
                </div>
                <div class="row g-4">
                    <div class="col-md-4 sw-reveal">
                        <div class="sw-feature-card text-center">
                            <span class="sw-feature-icon">🍫</span>
                            <h3>Chocolate Antillano</h3>
                            <p>Cacao de exportación con la receta clásica de la casa, intenso y cremoso.</p>
                        </div>
                    </div>
                    <div class="col-md-4 sw-reveal">
                        <div class="sw-feature-card text-center">
                            <span class="sw-feature-icon">🥥</span>
                            <h3>Coco Fresco</h3>
                            <p>Ralladura natural de coco caribeño para un sabor tropical irresistible.</p>
                        </div>
                    </div>
                    <div class="col-md-4 sw-reveal">
                        <div class="sw-feature-card text-center">
                            <span class="sw-feature-icon">🍓</span>
                            <h3>Guayaba Seleccionada</h3>
                            <p>La mermelada cubana más pura envuelta en masa hojaldrada dorada.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
