<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_sweet_flavors" name="Sweet Flavors Grid">
        <section class="s_sweet_flavors py-5 bg-cream" style="background-color: #F5F5DC;">
            <div class="container">
                <div class="text-center mb-5">
                    <h2 class="display-5">Nuestros Sabores Estrella</h2>
                    <p class="text-muted">Ingredientes de primera calidad en cada elaboración.</p>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 border-0 shadow-sm text-center p-4">
                            <i class="fa fa-birthday-cake fa-3x text-chocolate mb-3" style="color: #8B4513;"></i>
                            <h4>Chocolate Antillano</h4>
                            <p class="small text-muted">Cacao de exportación con la receta clásica de la casa.</p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 border-0 shadow-sm text-center p-4">
                            <i class="fa fa-sun-o fa-3x text-gold mb-3" style="color: #D4AF37;"></i>
                            <h4>Coco Fresco</h4>
                            <p class="small text-muted">Ralladura natural de coco caribeño para un sabor tropical.</p>
                        </div>
                    </div>
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 border-0 shadow-sm text-center p-4">
                            <i class="fa fa-leaf fa-3x text-success mb-3" style="color: #28a745;"></i>
                            <h4>Guayaba Seleccionada</h4>
                            <p class="small text-muted">La mermelada cubana más pura en masa hojaldrada.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>
</odoo>
