<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Product Page Enhancement -->
    <template id="product_pastry_info" inherit_id="website_sale.product" name="Product Pastry Specs">
        <xpath expr="//div[@id='product_details']" position="inside">
            <t t-if="product.is_pastry">
                <div class="sc-technical-specs mt-4 p-3 rounded" style="background: #FDF5E6; border-left: 5px solid #D2691E;">
                    <h5 class="text-uppercase mb-3" style="font-size: 0.9rem; letter-spacing: 1px; color: #8B4513;">
                        <i class="fa fa-info-circle me-2"/>Detalles del Maestro Pastelero
                    </h5>
                    <div class="row g-2">
                        <div class="col-6">
                            <span class="small text-muted d-block">Horneado</span>
                            <strong t-field="product.baking_time"/> h | <strong t-field="product.baking_temp"/>°C
                        </div>
                        <div class="col-6">
                            <span class="small text-muted d-block">Vida Útil</span>
                            <strong t-field="product.shelf_life_days"/> días
                        </div>
                        <div class="col-12 mt-2">
                            <t t-if="product.requires_refrigeration">
                                <span class="badge text-bg-info">
                                    <i class="fa fa-snowflake-o me-1"/> Requiere Refrigeración
                                </span>
                            </t>
                            <t t-if="product.custom_order">
                                <span class="badge text-bg-warning ms-1">
                                    <i class="fa fa-star me-1"/> Pedido Personalizado
                                </span>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Pastry Badge in Shop Grid -->
    <template id="products_item_pastry_badge" inherit_id="website_sale.products_item" active="True" name="Pastry Badge on Grid">
        <xpath expr="//form" position="inside">
            <t t-if="product.is_pastry">
                <div class="position-absolute top-0 end-0 m-2">
                    <span class="badge rounded-pill shadow-sm" style="background-color: #FFB7C5; color: #8B4513; border: 1px solid #8B4513;">
                        Pastelería
                    </span>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Premium footer matching recommendation design -->
    <template id="sc_footer" inherit_id="website.footer_custom" name="Sweet Caf&#233; Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <footer class="sw-footer">
                <div class="sw-footer-grid container">
                    <div class="sw-footer-brand">
                        <div class="sw-footer-logo">
                            <img src="/sweet_cafe_ecommerce/static/src/img/sweet_logo_icon.svg"
                                 alt="Sweet Caf&#233;" width="40" height="40"
                                 style="filter: drop-shadow(0 2px 6px rgba(200,149,108,0.35));"/>
                            <span class="sw-footer-name">Sweet Caf&#233;</span>
                        </div>
                        <p>Endulzando momentos especiales desde 2020. Reposter&#237;a artesanal cubana con tradici&#243;n, calidad y mucho amor en cada creaci&#243;n.</p>
                        <div class="sw-footer-social">
                            <a href="#" class="sw-footer-social-link" aria-label="Facebook"><i class="fa fa-facebook"/></a>
                            <a href="#" class="sw-footer-social-link" aria-label="Instagram"><i class="fa fa-instagram"/></a>
                            <a href="#" class="sw-footer-social-link" aria-label="WhatsApp"><i class="fa fa-whatsapp"/></a>
                        </div>
                    </div>
                    <div class="sw-footer-col">
                        <h4>Productos</h4>
                        <ul>
                            <li><a href="/shop">Tartas y Cakes</a></li>
                            <li><a href="/shop">Cupcakes</a></li>
                            <li><a href="/shop">Galletas</a></li>
                            <li><a href="/shop">Chocolates</a></li>
                        </ul>
                    </div>
                    <div class="sw-footer-col">
                        <h4>Empresa</h4>
                        <ul>
                            <li><a href="/">Sobre Nosotros</a></li>
                            <li><a href="/contactus">Sucursales</a></li>
                            <li><a href="/reservar">Reservas</a></li>
                            <li><a href="/contactus">Contacto</a></li>
                        </ul>
                    </div>
                    <div class="sw-footer-col">
                        <h4>Contacto</h4>
                        <ul>
                            <li><i class="fa fa-phone me-2"/>+(53) 7 830-XXXX</li>
                            <li><i class="fa fa-envelope me-2"/>pedidos@sweetcafe.cu</li>
                            <li><i class="fa fa-clock me-2"/>Lun&#8211;Sab 8:00&#8211;20:00</li>
                        </ul>
                    </div>
                </div>
                <div class="sw-footer-bottom">
                    <p>&#169; 2026 Sweet Caf&#233; Cuba. Todos los derechos reservados. Hecho con &#10084;&#65039; en Cuba.</p>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
