<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Activar categorias en sidebar izquierdo (comportamiento nativo de Odoo).
        Por defecto en Odoo 19 esta desactivado (active=False) y usa el filmstrip superior.
        Con esto el bloque .products_categories aparece en #products_grid_before.
    -->
    <record id="website_sale.products_categories" model="ir.ui.view">
        <field name="active">False</field>
    </record>

    <!-- Desactivar filmstrip de categorias en la barra superior (para no duplicar) -->
    <record id="website_sale.products_categories_top" model="ir.ui.view">
        <field name="active">False</field>
    </record>

    <!--
        Desactivar accordion en categorias: con el collapsible activo, las categorias
        sin hijos se renderizan igual que los filtros de atributos (accordion con flecha),
        haciendo imposible distinguirlos. Con esto las categorias se muestran como
        lista plana de enlaces, identico al mockup.
    -->
    <record id="website_sale.products_categories_list_collapsible" model="ir.ui.view">
        <field name="active">False</field>
    </record>

    <!-- Titulo "Categories" -> "Categorias" en sidebar -->
    <template id="sweet_categories_title" inherit_id="website_sale.products_categories_list" name="Sweet Categories Title">
        <xpath expr="//h6[@t-attf-class]" position="replace">
            <h6 t-attf-class="o_categories_collapse_title {{_titleClasses}}"><b>Categor&#237;as</b></h6>
        </xpath>
    </template>

    <!-- Product Page Enhancement -->
    <template id="product_pastry_info" inherit_id="website_sale.product" name="Product Pastry Specs">
        <xpath expr="//div[@id='product_details']" position="inside">
            <t t-if="product.is_pastry">
                <div class="sc-technical-specs mt-4 p-3 rounded" style="background: #FDF5E6; border-left: 5px solid #D2691E;">
                    <h5 class="text-uppercase mb-3" style="font-size: 0.9rem; letter-spacing: 1px; color: #8B4513;">
                        <i class="fa fa-info-circle me-2"/>Detalles del Maestro Pastelero
                    </h5>
                    <div class="row g-2">
                        <div class="col-6">
                            <span class="small text-muted d-block">Horneado</span>
                            <strong t-field="product.baking_time"/> h | <strong t-field="product.baking_temp"/>°C
                        </div>
                        <div class="col-6">
                            <span class="small text-muted d-block">Vida Útil</span>
                            <strong t-field="product.shelf_life_days"/> días
                        </div>
                        <div class="col-12 mt-2">
                            <t t-if="product.requires_refrigeration">
                                <span class="badge text-bg-info">
                                    <i class="fa fa-snowflake-o me-1"/> Requiere Refrigeración
                                </span>
                            </t>
                            <t t-if="product.custom_order">
                                <span class="badge text-bg-warning ms-1">
                                    <i class="fa fa-star me-1"/> Pedido Personalizado
                                </span>
                            </t>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Pastry Badge in Shop Grid -->
    <template id="products_item_pastry_badge" inherit_id="website_sale.products_item" active="True" name="Pastry Badge on Grid">
        <xpath expr="//form" position="inside">
            <t t-if="product.is_pastry">
                <div class="position-absolute top-0 end-0 m-2">
                    <span class="badge rounded-pill shadow-sm" style="background-color: #FFB7C5; color: #8B4513; border: 1px solid #8B4513;">
                        Pastelería
                    </span>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Premium footer matching recommendation design -->
    <template id="sc_footer" inherit_id="website.footer_custom" name="Sweet Caf&#233; Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <footer class="sw-footer">
                <div class="sw-footer-grid container">
                    <div class="sw-footer-brand">
                        <div class="sw-footer-logo">
                            <img src="/sweet_cafe_ecommerce/static/src/img/sweet_logo_icon.svg"
                                 alt="Sweet Caf&#233;" width="40" height="40"
                                 style="filter: drop-shadow(0 2px 6px rgba(200,149,108,0.35));"/>
                            <span class="sw-footer-name">Sweet Caf&#233;</span>
                        </div>
                        <p>Endulzando momentos especiales desde 2020. Reposter&#237;a artesanal cubana con tradici&#243;n, calidad y mucho amor en cada creaci&#243;n.</p>
                        <div class="sw-footer-social">
                            <a href="#" class="sw-footer-social-link" aria-label="Facebook"><i class="fa fa-facebook"/></a>
                            <a href="#" class="sw-footer-social-link" aria-label="Instagram"><i class="fa fa-instagram"/></a>
                            <a href="#" class="sw-footer-social-link" aria-label="WhatsApp"><i class="fa fa-whatsapp"/></a>
                        </div>
                    </div>
                    <div class="sw-footer-col">
                        <h4>Productos</h4>
                        <ul>
                            <li><a href="/shop">Tartas y Cakes</a></li>
                            <li><a href="/shop">Cupcakes</a></li>
                            <li><a href="/shop">Galletas</a></li>
                            <li><a href="/shop">Chocolates</a></li>
                        </ul>
                    </div>
                    <div class="sw-footer-col">
                        <h4>Empresa</h4>
                        <ul>
                            <li><a href="/">Sobre Nosotros</a></li>
                            <li><a href="/contactus">Sucursales</a></li>
                            <li><a href="/reservar">Reservas</a></li>
                            <li><a href="/contactus">Contacto</a></li>
                        </ul>
                    </div>
                    <div class="sw-footer-col">
                        <h4>Contacto</h4>
                        <ul>
                            <li><i class="fa fa-phone me-2"/>+(53) 7 830-XXXX</li>
                            <li><i class="fa fa-envelope me-2"/>pedidos@sweetcafe.cu</li>
                            <li><i class="fa fa-clock me-2"/>Lun&#8211;Sab 8:00&#8211;20:00</li>
                        </ul>
                    </div>
                </div>
                <div class="sw-footer-bottom">
                    <p>&#169; 2026 Sweet Caf&#233; Cuba. Todos los derechos reservados. Hecho con &#10084;&#65039; en Cuba.</p>
                </div>
            </footer>
        </xpath>
    </template>

    <!-- ═══════════════════════════════════════════════════════════════
         SHOP PAGE — Hero injection
         ESTRATEGIA CORRECTA: NO reemplazamos #wrap.
         Solo inyectamos el hero ANTES de #o_wsale_container para que
         Odoo maneje 100% su flujo nativo:
           • Sidebar con categorías y atributos (y offcanvas móvil)
           • Grid de productos con bins/products_item
           • Paginación nativa
           • Carrito JS (a-submit, json-rpc)
           • Breadcrumbs, búsqueda, sort — todo nativo
         El estilo visual se aplica vía shop.scss sobre las clases nativas.
    ═══════════════════════════════════════════════════════════════ -->
    <template id="sweet_shop_page" inherit_id="website_sale.products" name="Sweet Café Shop Hero">
        <xpath expr="//div[@id='o_wsale_container']" position="before">
            <div class="sw-shop-hero-premium container mb-4">
                <div class="sw-shop-hero-bg">
                    <div class="sw-particle" style="width:8px;height:8px;top:20%;left:10%;animation-delay:0s;"/>
                    <div class="sw-particle" style="width:12px;height:12px;top:60%;left:20%;animation-delay:1s;"/>
                    <div class="sw-particle" style="width:6px;height:6px;top:30%;left:35%;animation-delay:2s;"/>
                    <div class="sw-particle" style="width:10px;height:10px;top:70%;left:15%;animation-delay:3s;"/>
                    <div class="sw-particle" style="width:8px;height:8px;top:40%;left:25%;animation-delay:4s;"/>
                    <div class="sw-particle" style="width:14px;height:14px;top:15%;left:40%;animation-delay:1.5s;"/>
                    <div class="sw-particle" style="width:6px;height:6px;top:80%;left:30%;animation-delay:2.5s;"/>
                    <div class="sw-hero-ring" style="width:300px;height:300px;top:50%;left:62%;transform:translate(-50%,-50%);"/>
                    <div class="sw-hero-ring" style="width:420px;height:420px;top:50%;left:62%;transform:translate(-50%,-50%);animation-delay:1s;"/>
                    <div class="sw-hero-ring" style="width:540px;height:540px;top:50%;left:62%;transform:translate(-50%,-50%);animation-delay:2s;"/>
                </div>
                <div class="sw-hero-float-product">
                    <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=500&amp;h=500&amp;fit=crop"
                         alt="Tarta Premium Sweet Caf&#233;" loading="lazy"/>
                </div>
                <div class="sw-shop-hero-content">
                    <div class="sw-badge mb-3"
                         style="background:rgba(255,255,255,0.15);border:1px solid rgba(255,255,255,0.2);color:#fff;display:inline-flex;align-items:center;gap:6px;padding:6px 16px;border-radius:50px;font-size:0.8rem;font-weight:600;letter-spacing:1px;">
                        ✦ Sabor Aut&#233;ntico Cubano
                    </div>
                    <h1 class="sw-shop-hero-title">Nuestra <span>Tienda</span></h1>
                    <p class="sw-shop-hero-subtitle">
                        Descubre nuestros pasteles artesanales, postres y delicias preparadas
                        con amor y los mejores ingredientes.
                    </p>
                    <div class="sw-shop-hero-stats">
                        <div class="sw-shop-hero-stat">
                            <div class="sw-shop-hero-stat-number"
                                 t-esc="product_count if product_count else '&#8734;'"/>
                            <div class="sw-shop-hero-stat-label">Productos</div>
                        </div>
                        <div class="sw-shop-hero-stat">
                            <div class="sw-shop-hero-stat-number">24h</div>
                            <div class="sw-shop-hero-stat-label">Entrega</div>
                        </div>
                        <div class="sw-shop-hero-stat">
                            <div class="sw-shop-hero-stat-number">100%</div>
                            <div class="sw-shop-hero-stat-label">Artesanal</div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
