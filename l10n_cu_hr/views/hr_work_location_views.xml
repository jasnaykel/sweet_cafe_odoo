<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_work_location_form_view_inherit" model="ir.ui.view">
        <field name="name">hr.work.location.view.form.inherit</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id'][1]" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <!-- <field name="address_id" position="replace">
                <field name="address_id" readonly="1"
                    force_save="1"
                    context="{'show_address': 1}"
                    options="{'always_reload': True, 'highlight_first_line': True}" />
            </field> -->
        </field>
    </record>
    <record id="hr.hr_work_location_action" model="ir.actions.act_window">
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
    </record>
</odoo>