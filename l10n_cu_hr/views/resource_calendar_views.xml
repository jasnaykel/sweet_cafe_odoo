<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<record id="view_resource_calendar_tree_inherit" model="ir.ui.view">
    <field name="name">resource.calendar.tree.inherit</field>
    <field name="model">resource.calendar</field>
    <field name="inherit_id" ref="resource.view_resource_calendar_tree"/>
    <field name="arch" type="xml">
        <xpath expr="//field[@name='company_id']" position="replace">
        </xpath>
    </field>
</record>

<record id="resource_calendar_form_inherit" model="ir.ui.view">
        <field name="name">resource.calendar.form.inherit</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="replace"/>
        </field>
</record>
<record id="view_resource_calendar_search_inherit" model="ir.ui.view">
        <field name="name">resource.calendar.search.inherit</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="replace"/>
        </field>
</record>

</odoo>