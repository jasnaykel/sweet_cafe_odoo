<odoo>
    <data>
        <record id="res_company_view_form" model="ir.ui.view">
            <field name="name">res.company.form.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='branches']" position="after">
                    <page string="Configuración de reportes" name="reports">
                        <group>
                            <group>
                                <field name="central_office" required="1"/>
                                <field name="central_office_abbreviation" required="1"/>
                                <field name="business_group" required="1"/>
                                <field name="abbreviation_group" required="1"/>
                                <field name="ministry" required="1"/>
                                <field name="ministry_abbreviation" required="1"/>
                            </group>
                            <group>
                                <field name="job_id" required="1"/>
                                <field name="resolution" required="1"/>
                                <field name="employer" required="1"/>
                                <field name="director" required="1"/>
                                <field name="legal_address" required="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
                <xpath expr="//field[@name='phone']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//field[@name='email']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
