<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_form_hr_contract_employee_inherited" model="ir.ui.view">
        <field name="name">view_hr_contract_employee_form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_versions']" position="after">
                <button name="action_open_movement_list"
                        class="oe_stat_button"
                        icon="fa-book"
                        type="object"
                        invisible="movements_count == 0"
                        groups="hr.group_hr_manager">
                    <field name="movements_count" widget="statinfo" string="Movements"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>


