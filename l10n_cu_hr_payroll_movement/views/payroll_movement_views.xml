<odoo>
    <data>
        <record id="hr_payroll_employee_tree" model="ir.ui.view">
            <field name="name">hr.payroll.employee.tree</field>
            <field name="model">payroll.movement</field>
            <field name="arch" type="xml">
                <list name="payroll_movement" string="Payroll Movement">
                    <field name="employee_id"/>
                    <field name="contract_id"/>
                    <field name="details_movement_type_id"/>
                    <field name="effective_date"/>
                    <field name="actual_situation_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="hr_payroll_employee_form" model="ir.ui.view">
            <field name="name">hr.payroll.employee.form</field>
            <field name="model">payroll.movement</field>
            <field name="arch" type="xml">
                <form name="payroll_movement" string="Payroll Movement" create="false">
                    <header>
                        <button name="action_approve" string="Confirm" type="object" class="oe_highlight"
                                invisible="state == 'open'"/>

                        <button name="print_approve_movement" string="Imprimir modelo SC-4-02" type="object"
                                class="oe_highlight" invisible="state != 'open'"/>

                        <field name="state" widget="statusbar" readonly="1"/>
                    </header>
                    <sheet>
                        <field name="company_id" invisible="1"/>
                         <field name="is_initial_movement" invisible="1"/>
                        <div class="oe_title pr-0" name="title">
                            <h1 class="d-flex flex-row justify-content-between">
                                <field name="employee_id" class="text-truncate" placeholder="Employee name"
                                       readonly="state != 'draft' or is_initial_movement" options="{'no_create': True}"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="movement_type" invisible="1"/>
                                <field name="contract_id" readonly="state != 'draft'"
                                       options="{'no_create': True}" placeholder="Contract" required="1"/>
                                <field name="details_movement_type_id" readonly="state != 'draft' or is_initial_movement" required="1"/>

                                    <field name="reasons_movement_type_id"
                                       context="{'default_details_movement_type_id': details_movement_type_id,
                                       'default_reasons_movement_type_id':reasons_movement_type_id}"
                                    options="{'no_create_edit': False, 'no_quick_create': True, 'always_reload': True}"
                                    readonly="state != 'draft'" required="1"/>

                            </group>

                            <group>
                                <field name="date" readonly="state != 'draft'" required="1"/>
                                <field name="effective_date" readonly="state != 'draft'"
                                       required="1"/>
                            </group>
                        </group>
                        <group>

                            <group name="actual" string="Actual Situation">
                                <field name="actual_situation_id" required="1"
                                       readonly="state != 'draft' or movement_type in ['low','change']"/>
                                <field name="actual_department_id" required="1"
                                       readonly="state != 'draft' or movement_type in ['low','change']"
                                       options="{'no_create': True}"/>
                                <field name="actual_resource_calendar_id" required="1"
                                       options="{'no_create': True}"
                                       readonly="state != 'draft' or movement_type in ['low','change']"/>
                                <field name="actual_occupational_category_id" required="1"
                                       readonly="state != 'draft' or movement_type in ['low','change']"
                                       options="{'no_create': True}"/>
                                <field name="actual_wage" options="{'no_create': True}"
                                       readonly="state != 'draft' or movement_type in ['low','change']" required="1"
                                />
                            </group>

                            <group name="new" string="New Situation" required="movement_type == 'change'"
                                   invisible="movement_type != 'change'">
                                <field name="new_situation_id" required="movement_type == 'change'"
                                       readonly="state != 'draft'" invisible="movement_type != 'change'"/>
                                <field name="new_department_id" options="{'no_create': True}"
                                       required="movement_type == 'change'"
                                       readonly="state != 'draft'" invisible="movement_type != 'change'"/>
                                <field name="new_resource_calendar_id" options="{'no_create': True}"
                                       required="movement_type == 'change'"
                                       readonly="state != 'draft'" invisible="movement_type != 'change'"/>
                                <field name="new_occupational_category_id" options="{'no_create': True}"
                                       required="movement_type == 'change'"
                                       readonly="state != 'draft'" invisible="movement_type != 'change'"/>
                                <field name="new_wage" options="{'no_create': True}"
                                       required="movement_type == 'change'"
                                       readonly="state != 'draft'" invisible="movement_type != 'change'"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_payroll" model="ir.actions.act_window">
            <field name="name">Payroll Movements</field>
            <field name="res_model">payroll.movement</field>
            <field name="view_mode">list,form</field>
                    <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Movement found ! Let's create one
            </p>
            <p>
                Use Movement to categorize your Employees.
            </p>
        </field>
        </record>


        <menuitem
            id="hr_menu_hr_payroll"
            name="Payroll Movements"
            action="action_hr_payroll"
            parent="hr.menu_hr_employee_payroll"
            sequence="8"
            groups="hr.group_hr_manager"/>
    </data>
</odoo>