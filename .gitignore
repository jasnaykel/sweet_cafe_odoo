# Ignorar todo
/*

# Excepto los módulos de Sweet Café
!/sweet_cafe_management/
!/sweet_cafe_ecommerce/
!/sweet_cafe_configurator/

# Módulos RRHH Cuba
!/l10n_cu_address/
!/l10n_cu_banks/
!/l10n_cu_hr/
!/l10n_cu_hr_contract/
!/l10n_cu_hr_employee_contract/
!/l10n_cu_hr_payroll/
!/l10n_cu_hr_payroll_movement/
!/rrhh_5p/

# Y el propio .gitignore
!/.gitignore

# Archivos raíz de documentación e ingeniería
!/README.md
!/CONTEXT.md
!/ARCHITECTURE.md
!/ANALISIS_PROYECTO_2026.md

# Estándares del agente y skills locales
!/.github/
!/.github/copilot-instructions.md
!/.github/skills/
!/.github/skills/**

# Documentación técnica (specs y ADRs)
!/docs/
!/docs/**

# QA Agent (Playwright tests)
!/qa-agent/
qa-agent/node_modules/
qa-agent/.auth/
qa-agent/test-results/
qa-agent/playwright-report/
qa-agent/reports/
qa-agent/.env

# Ignorar archivos temporales y basura dentro de los módulos
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.DS_Store
**/Thumbs.db
**/*.swp
**/*.swo
**/*~
**.bak
